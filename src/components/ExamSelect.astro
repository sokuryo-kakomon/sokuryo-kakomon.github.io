---
import ProgressBar from './react/ProgressBar';
import { EXAMS, categoriesOf } from '../lib/data';
import type { Exam } from '../lib/types';

// トップ（測量士）と /hoshi/（測量士補）の「年度別・分野別」の欄
interface Props { exam: Exam }
const { exam } = Astro.props;
const ex = EXAMS[exam];
const qs = ex.questions;
const total = qs.length;
const ys = ex.years.filter((y) => qs.some((q) => q.year === y.id));
const cats = categoriesOf(exam).filter((c) => c.count > 0);
const exq = exam === 'shi' ? '' : 'exam=hoshi&';
---
<section id="select" class="bg-paper-deep/50 border-y border-line scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 py-14">
    <div class="text-center mb-8">
      <div class="eyebrow mb-2">{ex.name}の演習を選ぶ</div>
      <h2 class="text-3xl">年度別・分野別</h2>
    </div>
    <div class="card p-4 max-w-xl mx-auto mb-8"><ProgressBar client:load ids={qs.map((q) => q.id)} label={`${ex.name}の進捗（この端末）`} /></div>

    <h3 class="text-lg mb-3">年度別に通しで解く</h3>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-10">
      {ys.map((y) => (
        <article class="card p-5 flex flex-col">
          <h4 class="serif text-xl">{y.label}</h4>
          <div class="text-xs text-ink-soft mb-3">{y.examDate}実施 ・ 全{y.count}問</div>
          <a href={`/practice/?${exq}year=${y.id}`} class="btn btn-primary btn-sm mb-2">この年度を解く</a>
          <div class="flex gap-3 text-xs mt-auto">
            <a href={`${ex.base}/${y.id}/`}>問題一覧</a>
            {y.pdf.questions && <a href={y.pdf.questions} target="_blank" rel="noopener">公式問題PDF</a>}
            {y.pdf.answers && <a href={y.pdf.answers} target="_blank" rel="noopener">公式解答PDF</a>}
          </div>
        </article>
      ))}
    </div>

    <h3 class="text-lg mb-3">分野別に固める</h3>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {cats.map((c) => (
        <article class="card p-4 flex items-center gap-3">
          <span class="text-2xl">{c.icon}</span>
          <div class="min-w-0 flex-1">
            <div class="font-bold">{c.name}</div>
            <div class="text-xs text-ink-soft">{c.count}問 ・ {Math.round((c.count / total) * 100)}%</div>
          </div>
          <a href={`/practice/?${exq}cat=${c.slug}`} class="btn btn-primary btn-sm">解く</a>
          {exam === 'shi' && <a href={`/guide/${c.slug}/`} class="btn btn-ghost btn-sm">ガイド</a>}
        </article>
      ))}
    </div>
  </div>
</section>
