---
import { years, categories, questions } from '../lib/data';
import ProgressBar from './react/ProgressBar';
import AmazonBox from './AmazonBox.astro';
const path = Astro.url.pathname;
const allIds = questions.map((q) => q.id);
const active = (h: string) => path === h || (h !== '/' && path.startsWith(h));
---
<aside class="sidebar bg-paper lg:bg-transparent w-72 shrink-0 p-4 lg:p-0 lg:sticky lg:top-20">
  <div class="card p-4 mb-4"><ProgressBar client:load ids={allIds} label="全体の進捗" compact /></div>
  <a href="/practice/" class="btn btn-primary w-full mb-5">演習を始める</a>

  <div class="text-xs tracking-widest text-ink-faint px-2 mb-1">年度別</div>
  <div class="space-y-0.5">
    {years.map((y) => (
      <a href={`/${y.id}/`} class={'sb-link' + (active(`/${y.id}/`) ? ' is-active' : '')}>
        <span>{y.label}</span><span class="sb-count">{y.count}問</span>
      </a>
    ))}
  </div>

  <div class="text-xs tracking-widest text-ink-faint px-2 mt-5 mb-1">分野別</div>
  <div class="space-y-0.5">
    {categories.map((c) => (
      <a href={`/guide/${c.slug}/`} class={'sb-link' + (active(`/guide/${c.slug}/`) ? ' is-active' : '')}>
        <span>{c.icon} {c.name}</span><span class="sb-count">{c.count}問</span>
      </a>
    ))}
  </div>

  <div class="mt-5 space-y-0.5">
    <a href="/progress/" class={'sb-link' + (active('/progress/') ? ' is-active' : '')}>📈 成績表</a>
    <a href="/guide/" class={'sb-link' + (path === '/guide/' ? ' is-active' : '')}>📚 分野別ガイド一覧</a>
  </div>

  <div class="mt-6 hidden lg:block"><AmazonBox compact /></div>
</aside>
