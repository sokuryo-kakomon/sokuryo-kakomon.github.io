---
// トップの切り替え。測量士は / 、測量士補は /hoshi/
interface Props { exam: 'shi' | 'hoshi' }
const { exam } = Astro.props;
const tab = (on: boolean) => 'text-center px-5 py-2 rounded-dojo no-underline ' + (on ? 'bg-card text-ink font-bold shadow-sm' : 'text-ink-soft hover:text-ink');
---
<nav class="inline-grid grid-cols-2 gap-1 p-1 mb-6 rounded-dojo bg-paper-deep text-sm md:text-base" aria-label="試験の切り替え">
  <a href="/" class={tab(exam === 'shi')} aria-current={exam === 'shi' ? 'page' : undefined}>測量士</a>
  <a href="/hoshi/" class={tab(exam === 'hoshi')} aria-current={exam === 'hoshi' ? 'page' : undefined}>測量士補</a>
</nav>
