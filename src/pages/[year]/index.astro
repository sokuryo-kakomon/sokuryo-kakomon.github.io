---
import App from '../../layouts/App.astro';
import ListStatus from '../../components/react/ListStatus';
import { years, ofYear, pageTitle, site } from '../../lib/data';

export function getStaticPaths() {
  return years.map((y) => ({ params: { year: y.id }, props: { y } }));
}
const { y } = Astro.props;
const qs = ofYear(y.id);
const title = pageTitle(`${y.label} 測量士試験 午前 全${qs.length}問の解答と解説`);
const description = `${y.label}（${y.examDate}実施）測量士試験 午前・択一式の全${qs.length}問を、解答と詳しい解説つきで掲載。1問ずつ解いて正誤を記録できます。`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: site.url + `/${y.id}/`,
};
---
<App title={title} description={description} path={`/${y.id}/`} jsonLd={jsonLd}>
  <nav class="text-sm text-ink-soft mb-2"><a href="/">トップ</a> ／ {y.label}</nav>
  <h1 class="text-2xl mb-1">{y.label} 測量士試験 午前（択一式）</h1>
  <p class="text-ink-soft text-sm mb-4">{y.examDate}実施 ・ 全{qs.length}問</p>
  <div class="flex flex-wrap gap-2 mb-6">
    <a class="btn btn-primary" href={`/practice/?year=${y.id}`}>この年度を通しで解く</a>
    {y.pdf.questions && <a class="btn btn-ghost btn-sm" href={y.pdf.questions} target="_blank" rel="noopener">公式問題 PDF</a>}
    {y.pdf.answers && <a class="btn btn-ghost btn-sm" href={y.pdf.answers} target="_blank" rel="noopener">公式解答 PDF</a>}
  </div>
  <ol class="card divide-y divide-line">
    {qs.map((q) => (
      <li data-qid={q.id}>
        <a href={q.url} class="flex gap-3 items-start p-3 no-underline text-ink hover:bg-paper-deep/60">
          <span class="mark-st w-5 shrink-0 text-center pt-0.5"></span>
          <span class="w-14 shrink-0 font-bold">第{q.num}問</span>
          <span class="min-w-0 flex-1">
            <span class="chip text-[.7rem] mr-2 align-middle" style={q.categoryStyle}>{q.categoryIcon} {q.category}</span>
            <span class="text-sm text-ink-soft">{q.statementText.slice(0, 72)}…</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  <p class="text-xs text-ink-faint mt-3">○ 前回正解 ・ × 前回不正解 ・ － 未回答（記録はこの端末内のみ）</p>
  <ListStatus client:load />
</App>
