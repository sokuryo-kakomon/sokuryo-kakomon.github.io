---
import Base from '../layouts/Base.astro';
import { pageTitle } from '../lib/data';
// 11-04 本人が通し読み済み。メールは ここの登記簿 と共通の info@
const rows: [string, string][] = [
  ['販売事業者', '居初 一志'],
  ['運営責任者', '居初 一志'],
  ['所在地', '愛知県清須市西枇杷島町城並2丁目3-4 サティスファクション202'],
  ['電話番号', '請求があった場合、遅滞なく開示します'],
  ['メールアドレス', 'info@kokonotoukibo.jp'],
  ['販売価格', '有料プラン：月額 980円（税込）'],
  ['提供内容', 'AI に質問（1日20回・1か月200回まで）、模擬試験（回数の制限なし）、一問一答（回数の制限なし）。過去問・解説・成績表は有料プランに入らなくても無料で使えます'],
  ['商品代金以外の必要料金', 'インターネット接続にかかる通信料はお客様のご負担となります'],
  ['支払方法', 'クレジットカード（Stripe による決済）'],
  ['支払時期', 'お申し込み時に初回分をお支払いいただき、以後は毎月同じ日に自動で更新・決済されます'],
  ['提供時期', '決済完了後、すぐに利用コードを表示し、ご利用いただけます'],
  ['解約', '「有料プラン」ページの「契約の確認・カード変更・解約」からいつでも解約できます。解約後も、支払い済みの期間の終わりまではご利用いただけます'],
  ['返品・返金', 'デジタルサービスの性質上、支払い済みの料金の返金（日割りを含む）はいたしません。ただし当方の責による不具合で利用できなかった場合はご相談ください'],
  ['動作環境', '最新版の Chrome・Safari・Edge・Firefox'],
];
---
<Base title={pageTitle('特定商取引法に基づく表記')} description="測量士・測量士補 過去問ドリル（有料プラン）の特定商取引法に基づく表記" path="/tokushoho/">
  <main class="max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-ink-soft mb-2"><a href="/">トップ</a> ／ 特定商取引法に基づく表記</nav>
    <h1 class="text-2xl mb-4">特定商取引法に基づく表記</h1>
    <div class="card p-6 qhtml">
      <table>
        {rows.map(([k, v]) => <tr><th class="whitespace-nowrap align-top">{k}</th><td>{v}</td></tr>)}
      </table>
    </div>
  </main>
</Base>
