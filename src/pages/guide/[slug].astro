---
import App from '../../layouts/App.astro';
import ListStatus from '../../components/react/ListStatus';
import ProgressBar from '../../components/react/ProgressBar';
import { guides, byId, categoryBySlug, pageTitle, site } from '../../lib/data';

export function getStaticPaths() {
  return guides.guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const c = categoryBySlug(g.slug);
const qs = g.questionIds.map((id) => byId.get(id)!);
const title = pageTitle(`${g.name}｜測量士試験 分野別ガイドと過去問${qs.length}問`);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: `${g.name} ― 測量士試験 分野別ガイド`, description: g.description,
  url: site.url + g.url, inLanguage: 'ja', author: { '@type': 'Person', name: '測量士・測量士補 過去問ドリル 運営者' },
};
---
<App title={title} description={g.description} path={g.url} ogType="article" jsonLd={jsonLd}>
  <nav class="text-sm text-ink-soft mb-2"><a href="/">トップ</a> ／ <a href="/guide/">分野別ガイド</a> ／ {g.name}</nav>
  <h1 class="text-2xl md:text-3xl mb-3">{c?.icon} {g.name}<span class="block text-sm font-sans font-normal text-ink-soft mt-1">測量士試験 午前 ― 分野別ガイド</span></h1>
  <p class="text-ink-soft leading-relaxed mb-5" set:html={g.leadHtml} />

  <div class="card p-4 mb-6 flex flex-wrap items-center gap-4">
    <div class="flex-1 min-w-56"><ProgressBar client:load ids={g.questionIds} label={`${g.name}の進捗`} /></div>
    <a href={`/practice/?cat=${g.slug}`} class="btn btn-primary">この分野を解く（{qs.length}問）</a>
  </div>

  <article class="card p-5 md:p-7 qhtml" set:html={g.bodyHtml} />

  <h2 class="text-xl mt-10 mb-3">この分野の過去問 {qs.length}問</h2>
  <ol class="card divide-y divide-line">
    {qs.map((q) => (
      <li data-qid={q.id}>
        <a href={q.url} class="flex gap-3 items-start p-3 no-underline text-ink hover:bg-paper-deep/60">
          <span class="mark-st w-5 shrink-0 text-center pt-0.5"></span>
          <span class="w-24 shrink-0 font-bold">{q.yearLabel.replace('年度', '')} 第{q.num}問</span>
          <span class="text-sm text-ink-soft min-w-0">{q.statementText.slice(0, 72)}…</span>
        </a>
      </li>
    ))}
  </ol>
  <ListStatus client:load />
</App>
